appname               = diskmounter
version               = 1.3.0
display_name          = 磁盘挂载管家
desc                  = 对系统盘以外的存储池硬盘进行图形化挂载与安全卸载；卸载后硬盘自动静默并停转省电。新增「硬盘停转」面板：扫描全部数据盘，仅允许停转「空闲且不属于任何活跃存储池」的硬盘（系统盘、活跃存储池盘、已挂载盘强制保护），支持手动停转、唤醒与「恢复使用」（唤醒+重挂载）。不影响磁盘数据。
platform              = x86
source                = thirdparty
maintainer            = WorkBuddy
maintainer_url        = https://www.workbuddy.cn
distributor           = WorkBuddy
distributor_url       = https://www.workbuddy.cn
service_port          = 5688
checkport             = true
os_min_version        = 0.9.0
desktop_uidir         = ui
desktop_applaunchname = diskmounter.Application
ctl_stop              = true
install_type          = root
changelog             = 新增硬盘停转功能：卸载存储池后自动停转成员硬盘（可在面板关闭「卸载后自动停转」）；新增「硬盘停转」选项卡，扫描全部数据盘并按安全等级分类，仅空闲且非活跃存储池的硬盘可手动停转/唤醒/恢复使用；系统盘、活跃存储池盘、已挂载盘一律强制保护禁止停转；挂载前自动唤醒成员盘避免阵列误判降级；reconcile 维持期望卸载池的停转状态；新增 CLI: diskm.py spindown-stopped
checksum              = dc9fd114a0862efa813490836073ccf2
