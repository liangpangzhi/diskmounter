appname=diskmounter
version=1.2.7
display_name=磁盘挂载管家
desc=对系统盘以外的存储池硬盘进行图形化挂载与安全卸载。卸载前自动检查占用进程并拒绝危险操作，卸载时依次 sync、umount、停用 LVM 卷组与 mdadm 阵列（ZFS 池执行 export），确保硬盘完全静默、可安全拔出；期望状态持久化，设备重启后自动维持。不影响磁盘数据。
platform=x86
source=thirdparty
maintainer=WorkBuddy
maintainer_url=https://www.workbuddy.cn
distributor=WorkBuddy
distributor_url=https://www.workbuddy.cn
service_port=5688
checkport=true
os_min_version=0.9.0
desktop_uidir=ui
desktop_applaunchname=diskmounter.Application
ctl_stop=true
install_type=root
changelog=修复存储池实际未挂载但应用显示"已挂载"且不自动恢复：lvm_pools的mounted标志改为依据/proc/mounts真实挂载状态判定(不再用历史known挂载点误判为已挂载)，reconcile据此自动重新挂载vol3/vol7；卸载LVM前先终止文件监控(fanotify)释放卷句柄并加重试，修复"停用卷组失败: Logical volume ... in use"
